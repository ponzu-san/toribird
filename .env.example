# Supabase（toribird カタログ用）
# Project Settings → API Keys から取得

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# シードスクリプト（npm run seed:catalog）専用。絶対に公開しないこと
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 開発用アクセス状態切替パネル（本番 Vercel では設定しない）
# NEXT_PUBLIC_ENABLE_DEV_TOOLS=true

# サイト URL の手動指定（通常不要。リクエスト Host から自動解決）
# headers が取れない特殊ケースのみ。Vercel 本番では設定しないこと
# NEXT_PUBLIC_SITE_URL=http://localhost:3100

# DEV パネル自動ログイン用（.env.local のみ。本番 Vercel では設定しない）
# DEV_TEST_EMAIL=dev@example.com
# DEV_TEST_PASSWORD=your-dev-password

# ステージング Basic 認証（toribird-ebon 等、非公開確認用 Vercel Production のみ）
# STAGING_BASIC_AUTH_USER=your-name
# STAGING_BASIC_AUTH_PASSWORD=your-strong-password
